# Dolphin (KDE) service menu: "Compress with Rcomp" on any files or folders.
[Desktop Entry]
Type=Service
MimeType=application/octet-stream;inode/directory;all/allfiles;
Actions=rcompCompress;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Priority=TopLevel

[Desktop Action rcompCompress]
Name=Compress with Rcomp
Icon=Rcomp
Exec=Rcomp --compress %F
