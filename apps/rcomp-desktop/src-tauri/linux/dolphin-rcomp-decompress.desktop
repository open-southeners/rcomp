# Dolphin (KDE) service menu: "Decompress with Rcomp" on supported archives.
[Desktop Entry]
Type=Service
MimeType=application/zip;application/x-7z-compressed;application/vnd.rar;application/x-rar;application/x-tar;application/gzip;application/x-gzip;application/x-compressed-tar;application/x-bzip2;application/x-bzip;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz;application/x-xz-compressed-tar;application/zstd;application/x-zstd;application/x-zstd-compressed-tar;application/x-lz4;application/x-lz4-compressed-tar;application/x-brotli;
Actions=rcompDecompress;
X-KDE-ServiceTypes=KonqPopupMenu/Plugin
X-KDE-Priority=TopLevel

[Desktop Action rcompDecompress]
Name=Decompress with Rcomp
Icon=Rcomp
Exec=Rcomp --decompress %F
