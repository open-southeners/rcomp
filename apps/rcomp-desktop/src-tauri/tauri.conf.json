{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rcomp",
  "identifier": "com.opensoutheners.rcomp",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build && bun run build:cli"
  },
  "app": {
    "windows": [
      {
        "title": "Rcomp",
        "width": 900,
        "height": 600,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 8, "y": 30 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; form-action 'none'",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Compress and extract archives",
    "longDescription": "rcomp is a fast, cross-platform compression and archive utility that supports tar, zip, 7z, zstd, gzip, bzip2, xz, lz4, brotli, and more.",
    "copyright": "Copyright © 2026 Ruben R",
    "publisher": "Open Southeners",
    "fileAssociations": [
      {
        "ext": [
          "zip",
          "7z",
          "rar",
          "tar",
          "gz",
          "tgz",
          "bz2",
          "tbz2",
          "xz",
          "txz",
          "zst",
          "tzst",
          "lz4",
          "br"
        ],
        "name": "Compressed archive",
        "description": "Compressed archive",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "application/zip;application/x-7z-compressed;application/vnd.rar;application/x-tar;application/gzip;application/x-bzip2;application/x-xz;application/zstd;application/x-lz4"
      }
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/context-menu.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "windows/context-menu.wxs"
        ],
        "componentGroupRefs": [
          "RcompContextMenu"
        ]
      }
    },
    "linux": {
      "appimage": {
        "files": {
          "/usr/bin/rcomp": "../../../target/rcomp-cli/rcomp"
        }
      },
      "deb": {
        "files": {
          "/usr/share/kio/servicemenus/rcomp-compress.desktop": "linux/dolphin-rcomp-compress.desktop",
          "/usr/share/kio/servicemenus/rcomp-decompress.desktop": "linux/dolphin-rcomp-decompress.desktop",
          "/usr/share/kservices5/ServiceMenus/rcomp-compress.desktop": "linux/dolphin-rcomp-compress.desktop",
          "/usr/share/kservices5/ServiceMenus/rcomp-decompress.desktop": "linux/dolphin-rcomp-decompress.desktop",
          "/usr/share/nemo/actions/rcomp-compress.nemo_action": "linux/rcomp-compress.nemo_action",
          "/usr/share/nemo/actions/rcomp-decompress.nemo_action": "linux/rcomp-decompress.nemo_action",
          "/usr/share/nautilus-python/extensions/rcomp-nautilus.py": "linux/rcomp-nautilus.py",
          "/usr/bin/rcomp": "../../../target/rcomp-cli/rcomp"
        },
        "recommends": [
          "python3-nautilus"
        ]
      },
      "rpm": {
        "files": {
          "/usr/share/kio/servicemenus/rcomp-compress.desktop": "linux/dolphin-rcomp-compress.desktop",
          "/usr/share/kio/servicemenus/rcomp-decompress.desktop": "linux/dolphin-rcomp-decompress.desktop",
          "/usr/share/kservices5/ServiceMenus/rcomp-compress.desktop": "linux/dolphin-rcomp-compress.desktop",
          "/usr/share/kservices5/ServiceMenus/rcomp-decompress.desktop": "linux/dolphin-rcomp-decompress.desktop",
          "/usr/share/nemo/actions/rcomp-compress.nemo_action": "linux/rcomp-compress.nemo_action",
          "/usr/share/nemo/actions/rcomp-decompress.nemo_action": "linux/rcomp-decompress.nemo_action",
          "/usr/share/nautilus-python/extensions/rcomp-nautilus.py": "linux/rcomp-nautilus.py",
          "/usr/bin/rcomp": "../../../target/rcomp-cli/rcomp"
        },
        "recommends": [
          "nautilus-python"
        ]
      }
    }
  }
}
